import { PrismaClient } from '@prisma/client'
import * as bcrypt from 'bcryptjs'

const seedPrisma = new PrismaClient()

const countries = [
  { code: "SG", name: "Singapura", flagUrl: "🇸🇬", coverImage: "https://images.unsplash.com/photo-1525625293386-3f8f99389edd?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80", visaType: "Bebas Visa", currency: "SGD" },
  { code: "JP", name: "Jepang", flagUrl: "🇯🇵", coverImage: "https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80", visaType: "e-Visa", currency: "JPY" },
  { code: "KR", name: "Korea Selatan", flagUrl: "🇰🇷", coverImage: "https://images.unsplash.com/photo-1517154421773-0529f29ea451?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80", visaType: "e-Visa", currency: "KRW" },
  { code: "UK", name: "Inggris Raya", flagUrl: "🇬🇧", coverImage: "https://images.unsplash.com/photo-1513635269975-59663e0ac1ad?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80", visaType: "Visa Kedutaan", currency: "GBP" },
  { code: "MY", name: "Malaysia", flagUrl: "🇲🇾", coverImage: "https://images.unsplash.com/photo-1596422846543-75c6fc197f07?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80", visaType: "Bebas Visa", currency: "MYR" },
  { code: "TH", name: "Thailand", flagUrl: "🇹🇭", coverImage: "https://images.unsplash.com/photo-1552465011-b4e21bf6e79a?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80", visaType: "Bebas Visa", currency: "THB" },
  { code: "AU", name: "Australia", flagUrl: "🇦🇺", coverImage: "https://images.unsplash.com/photo-1523482580672-f109ba8cb9be?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80", visaType: "e-Visa", currency: "AUD" },
  { code: "US", name: "Amerika Serikat", flagUrl: "🇺🇸", coverImage: "https://images.unsplash.com/photo-1501594907352-04cda38ebc29?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80", visaType: "Visa Kedutaan", currency: "USD" },
  { code: "AE", name: "Uni Emirat Arab", flagUrl: "🇦🇪", coverImage: "https://images.unsplash.com/photo-1512453979798-5ea266f8880c?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80", visaType: "e-Visa", currency: "AED" }
];

const mockProcedures = {
  PRE_DEPARTURE: [
    { stepNumber: 1, title: "Paspor Aktif Min. 6 Bulan", description: "Pastikan masa berlaku paspor Anda lebih dari 6 bulan dari tanggal keberangkatan." },
    { stepNumber: 2, title: "Apply e-Visa / K-ETA", description: "Lakukan pendaftaran e-Visa minimal 7 hari sebelum keberangkatan (jika diperlukan)." },
    { stepNumber: 3, title: "Asuransi Perjalanan", description: "Cetak polis asuransi yang menanggung biaya medis di negara tujuan." }
  ],
  DEPARTURE_DAY: [
    { stepNumber: 4, title: "Check-in Maskapai", description: "Siapkan tiket dan paspor di meja check-in." },
    { stepNumber: 5, title: "Imigrasi Keluar", description: "Proses cap keluar dari negara asal." }
  ],
  IN_FLIGHT_TRANSIT: [
    { stepNumber: 6, title: "Isi Kartu Kedatangan (Arrival Card)", description: "Dapatkan dari pramugari atau isi secara online sebelum mendarat." },
    { stepNumber: 7, title: "Deklarasi Pabean (Customs Form)", description: "Isi form bea cukai jika membawa barang berlebih." }
  ],
  ARRIVAL: [
    { stepNumber: 8, title: "Imigrasi Masuk", description: "Siapkan paspor, visa, dan bukti akomodasi." },
    { stepNumber: 9, title: "Pengambilan Bagasi", description: "Ambil bagasi di carousel yang ditentukan." }
  ]
};

async function main() {
  console.log('Seeding database...')
  
  // Hash password for default admin
  const salt = bcrypt.genSaltSync(10)
  const hashedPassword = bcrypt.hashSync('admin_imigrasi', salt)
  
  await seedPrisma.adminUser.upsert({
    where: { email: 'admin_imigrasi' },
    update: { password: hashedPassword },
    create: {
      email: 'admin_imigrasi',
      password: hashedPassword,
      name: 'Admin Imigrasi',
      role: 'SUPER_ADMIN',
    }
  })
  console.log('Admin user seeded')

  // Seed countries and procedures
  for (const c of countries) {
    const country = await seedPrisma.country.upsert({
      where: { code: c.code },
      update: c,
      create: c,
    })

    // Delete existing procedures to avoid duplicates
    await seedPrisma.procedure.deleteMany({
      where: { countryId: country.id }
    })

    for (const [phase, procedures] of Object.entries(mockProcedures)) {
      for (const p of procedures) {
        await seedPrisma.procedure.create({
          data: {
            countryId: country.id,
            phase,
            stepNumber: p.stepNumber,
            title: p.title,
            description: p.description,
            isMandatory: true,
            docRequired: "[]"
          }
        })
      }
    }
  }
  
  console.log('Countries and procedures seeded successfully!')
}

main()
  .catch((e) => {
    console.error(e)
    process.exit(1)
  })
  .finally(async () => {
    await seedPrisma.$disconnect()
  })

export {}
